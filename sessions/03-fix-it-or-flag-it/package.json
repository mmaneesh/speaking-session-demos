{
  "name": "fix-it-or-flag-it-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Fix It or Flag It: A self-fixing Playwright test loop wrapped in a 6-component Agent Harness.",
  "type": "module",
  "scripts": {
    "serve": "tsx shop-app/server.ts",
    "test": "playwright test --project=app",
    "test:all": "playwright test",
    "test:scenarios": "playwright test --project=scenarios",
    "basic-loop": "tsx harness/basic-loop.ts",
    "report": "playwright show-report",
    "harness": "tsx harness/agentic-harness.ts",
    "eval": "tsx harness/eval.ts",
    "reset": "tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "test:cart": "playwright test --project=app tests/cart",
    "test:checkout": "playwright test --project=app tests/checkout"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
